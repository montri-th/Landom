{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://landom.example/schema/profile-detail-overrides.schema.json",
  "title": "Owner-approved Landom profile detail overrides",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "sourceBasis",
    "addedPeople",
    "institutionLinkedInProfiles",
    "programLinkedInProfiles",
    "addedPublicSocialProfiles",
    "externalPublications",
    "programOverrides",
    "educationProgramOverrides",
    "educationCardOverrides",
    "engagementProgramNames",
    "engagementRoleNames",
    "existingEngagementOverrides",
    "addedEngagements",
    "cohortLabelSanitization",
    "workOverrides",
    "addedWorks",
    "addedContributions",
    "contributionRolesByProgram",
    "contributionRoleOverrides"
  ],
  "properties": {
    "contractVersion": { "const": "1.1" },
    "sourceBasis": { "type": "string", "minLength": 1 },
    "addedPeople": { "type": "array", "items": { "$ref": "#/$defs/addedPerson" } },
    "institutionLinkedInProfiles": { "type": "array", "items": { "$ref": "#/$defs/institutionLinkedInProfile" } },
    "programLinkedInProfiles": { "type": "array", "items": { "$ref": "#/$defs/programLinkedInProfile" } },
    "addedPublicSocialProfiles": { "type": "array", "items": { "$ref": "#/$defs/addedPublicSocialProfile" } },
    "externalPublications": { "type": "array", "items": { "$ref": "#/$defs/externalPublication" } },
    "programOverrides": { "type": "array", "items": { "$ref": "#/$defs/programOverride" } },
    "educationProgramOverrides": { "type": "array", "items": { "$ref": "#/$defs/educationProgramOverride" } },
    "educationCardOverrides": { "type": "array", "items": { "$ref": "#/$defs/educationCardOverride" } },
    "engagementProgramNames": { "$ref": "#/$defs/localizedMap" },
    "engagementRoleNames": { "$ref": "#/$defs/localizedMap" },
    "existingEngagementOverrides": { "type": "array", "items": { "$ref": "#/$defs/existingEngagementOverride" } },
    "addedEngagements": { "type": "array", "items": { "$ref": "#/$defs/addedEngagement" } },
    "cohortLabelSanitization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["removeRawAvailabilityNotes", "fallbackToProgramAndYear"],
      "properties": {
        "removeRawAvailabilityNotes": { "const": true },
        "fallbackToProgramAndYear": { "const": true }
      }
    },
    "workOverrides": { "type": "array", "items": { "$ref": "#/$defs/workOverride" } },
    "addedWorks": { "type": "array", "items": { "$ref": "#/$defs/addedWork" } },
    "addedContributions": { "type": "array", "items": { "$ref": "#/$defs/addedContribution" } },
    "contributionRolesByProgram": { "$ref": "#/$defs/localizedMap" },
    "contributionRoleOverrides": { "type": "array", "items": { "$ref": "#/$defs/contributionRoleOverride" } }
  },
  "$defs": {
    "personId": { "type": "string", "pattern": "^[SPI]\\d{4}$" },
    "localized": {
      "type": "object",
      "additionalProperties": false,
      "required": ["th", "en"],
      "properties": { "th": { "type": "string", "minLength": 1 }, "en": { "type": "string", "minLength": 1 } }
    },
    "formalShort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formal", "short"],
      "properties": { "formal": { "type": "string", "minLength": 1 }, "short": { "type": "string", "minLength": 1 } }
    },
    "formalShortLocalized": {
      "type": "object",
      "additionalProperties": false,
      "required": ["th", "en"],
      "properties": { "th": { "$ref": "#/$defs/formalShort" }, "en": { "$ref": "#/$defs/formalShort" } }
    },
    "localizedMap": { "type": "object", "additionalProperties": { "$ref": "#/$defs/localized" } },
    "nullableDate": { "type": ["string", "null"], "pattern": "^\\d{4}(?:-\\d{2}(?:-\\d{2})?)?$" },
    "addedPerson": {
      "type": "object",
      "additionalProperties": false,
      "required": ["personId", "fullName", "nickname", "currentStatus", "firstJoined", "migrationClassification", "verificationStatus"],
      "properties": {
        "personId": { "$ref": "#/$defs/personId" },
        "fullName": { "$ref": "#/$defs/localized" },
        "nickname": { "$ref": "#/$defs/localized" },
        "currentStatus": { "enum": ["active", "alumni"] },
        "firstJoined": { "$ref": "#/$defs/nullableDate" },
        "migrationClassification": { "const": "full_time" },
        "verificationStatus": { "const": "owner_supplied" }
      }
    },
    "ownerApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "approvedAt", "scope", "sourceRef"],
      "properties": {
        "status": { "const": "granted" },
        "approvedAt": { "type": "string", "format": "date" },
        "scope": { "const": "public_profile_link_only" },
        "sourceRef": { "type": "string", "minLength": 1 }
      }
    },
    "institutionLinkedInProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["institutionId", "linkedinUrl", "verificationStatus", "evidenceBasis", "retrievedAt"],
      "properties": {
        "institutionId": { "type": "string", "pattern": "^inst-[a-z0-9-]+$" },
        "linkedinUrl": { "type": "string", "format": "uri", "pattern": "^https://www\\.linkedin\\.com/(?:school|company)/" },
        "verificationStatus": { "const": "verified_official_page" },
        "evidenceBasis": { "const": "linkedin_page_name_and_linked_official_website_match_canonical_institution" },
        "retrievedAt": { "type": "string", "format": "date" }
      }
    },
    "programLinkedInProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["programId", "linkedinUrl", "verificationStatus", "evidenceBasis", "retrievedAt"],
      "properties": {
        "programId": { "type": "string", "pattern": "^program-[a-z0-9-]+$" },
        "linkedinUrl": { "type": "string", "format": "uri", "pattern": "^https://www\\.linkedin\\.com/(?:school|company|showcase)/" },
        "verificationStatus": { "const": "verified_official_page" },
        "evidenceBasis": { "const": "linkedin_page_exact_program_name_and_linked_official_website_match_canonical_program" },
        "retrievedAt": { "type": "string", "format": "date" }
      }
    },
    "addedPublicSocialProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["personId", "platform", "publicUrl", "verificationStatus", "identityEvidenceBasis", "consentStatus", "publicationBasis", "ownerApproval"],
      "properties": {
        "personId": { "$ref": "#/$defs/personId" },
        "platform": { "enum": ["linkedin", "github", "gitlab", "website", "facebook", "instagram", "tiktok"] },
        "publicUrl": { "type": "string", "format": "uri" },
        "verificationStatus": { "const": "verified" },
        "identityEvidenceBasis": { "type": "string", "minLength": 1 },
        "consentStatus": { "const": "pending" },
        "publicationBasis": { "const": "owner_authorized_public_profile_link" },
        "ownerApproval": { "$ref": "#/$defs/ownerApproval" }
      }
    },
    "externalPublication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publicationId", "personId", "title", "outlet", "volume", "year", "doi", "publicUrl", "ownerEvidenceUrl", "bibliographicUrl", "relationship", "scope", "verificationStatus", "publicationBasis", "evidenceNote"],
      "properties": {
        "publicationId": { "type": "string", "pattern": "^PUB\\d{4}$" },
        "personId": { "$ref": "#/$defs/personId" },
        "title": { "$ref": "#/$defs/localized" },
        "outlet": { "type": "string", "minLength": 1 },
        "volume": { "type": "string", "minLength": 1 },
        "year": { "type": "integer", "minimum": 1900, "maximum": 2100 },
        "doi": { "type": "string", "pattern": "^10\\.[0-9]{4,9}/[-._;()/:A-Z0-9]+$" },
        "publicUrl": { "type": "string", "format": "uri" },
        "ownerEvidenceUrl": { "type": "string", "format": "uri" },
        "bibliographicUrl": { "type": "string", "format": "uri" },
        "relationship": { "const": "coauthor" },
        "scope": { "const": "external_publication_not_landometer_contribution" },
        "verificationStatus": { "const": "owner_supplied_with_bibliographic_match" },
        "publicationBasis": { "const": "owner_authorized_external_publication_link" },
        "evidenceNote": { "type": "string", "minLength": 1 }
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "label"],
      "properties": { "start": { "type": ["string", "null"] }, "end": { "type": ["string", "null"] }, "label": { "type": ["string", "null"] } }
    },
    "programOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["programId", "names"],
      "properties": { "programId": { "type": "string", "pattern": "^program-[a-z0-9-]+$" }, "names": { "$ref": "#/$defs/formalShortLocalized" } }
    },
    "educationProgramOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["personId", "programId"],
      "properties": { "personId": { "$ref": "#/$defs/personId" }, "programId": { "type": "string", "pattern": "^program-[a-z0-9-]+$" } }
    },
    "educationCardOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["personId", "card", "detailMustRemainOfficial"],
      "properties": { "personId": { "$ref": "#/$defs/personId" }, "card": { "$ref": "#/$defs/localized" }, "detailMustRemainOfficial": { "const": true } }
    },
    "existingEngagementOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engagementId", "sequenceHint"],
      "properties": {
        "engagementId": { "type": "string", "pattern": "^E\\d{4}$" },
        "sequenceHint": { "type": "integer", "minimum": 1 },
        "start": { "type": ["string", "null"], "format": "date" },
        "end": { "type": ["string", "null"], "format": "date" },
        "status": { "enum": ["ongoing", "completed"] },
        "verificationStatus": { "type": "string", "minLength": 1 },
        "evidenceNote": { "type": "string", "minLength": 1 }
      }
    },
    "addedEngagement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engagementId", "personId", "category", "academicPlacementType", "programCode", "roleTitle", "cohortLabel", "start", "end", "status", "responsibilityWorkIds", "evidenceStatus", "verificationStatus", "sequenceHint"],
      "properties": {
        "engagementId": { "type": "string", "pattern": "^E\\d{4}$" },
        "personId": { "$ref": "#/$defs/personId" },
        "category": { "enum": ["full_time", "part_time", "internship", "program_participant"] },
        "academicPlacementType": { "enum": ["cooperative_education", "internship", "not_applicable"] },
        "programCode": { "type": "string", "minLength": 1 },
        "roleTitle": { "$ref": "#/$defs/localized" },
        "cohortLabel": { "type": ["string", "null"] },
        "start": { "$ref": "#/$defs/nullableDate" },
        "end": { "$ref": "#/$defs/nullableDate" },
        "status": { "enum": ["ongoing", "completed"] },
        "responsibilityWorkIds": { "type": "array", "items": { "type": "string", "pattern": "^work-[a-z0-9-]+$" } },
        "evidenceStatus": { "const": "owner_supplied" },
        "verificationStatus": { "type": "string", "minLength": 1 },
        "evidenceNote": { "type": "string", "minLength": 1 },
        "sequenceHint": { "type": "integer", "minimum": 1 }
      }
    },
    "workOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workId", "names"],
      "properties": { "workId": { "type": "string", "pattern": "^work-[a-z0-9-]+$" }, "names": { "$ref": "#/$defs/localized" } }
    },
    "addedWork": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workId", "parentProduct", "names", "type", "scopeLayer", "authorityStatus", "evidenceNote", "aliases"],
      "properties": {
        "workId": { "type": "string", "pattern": "^work-[a-z0-9-]+$" },
        "moduleSlug": { "type": "string", "pattern": "^dataset-[a-z0-9-]+$" },
        "evidenceUrl": { "type": "string", "format": "uri" },
        "parentProduct": { "type": "string", "minLength": 1 },
        "names": { "$ref": "#/$defs/localized" },
        "type": { "type": "string", "minLength": 1 },
        "scopeLayer": { "enum": ["shared_landometer", "product_specific", "partner_specific"] },
        "authorityStatus": { "type": "string", "minLength": 1 },
        "evidenceNote": { "type": "string", "minLength": 1 },
        "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "addedContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["personId", "workId", "engagementId", "role", "period"],
      "properties": {
        "personId": { "$ref": "#/$defs/personId" },
        "workId": { "type": "string", "pattern": "^work-[a-z0-9-]+$" },
        "engagementId": { "type": "string", "pattern": "^E\\d{4}$" },
        "role": { "$ref": "#/$defs/localized" },
        "period": { "$ref": "#/$defs/period" },
        "sourceRef": { "type": "string", "minLength": 1 },
        "evidenceNote": { "type": "string", "minLength": 1 }
      }
    },
    "contributionRoleOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workId", "role"],
      "properties": { "personId": { "$ref": "#/$defs/personId" }, "workId": { "type": "string", "pattern": "^work-[a-z0-9-]+$" }, "role": { "$ref": "#/$defs/localized" } }
    }
  }
}
