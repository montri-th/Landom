{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://landom.example/schema/site-data.schema.json",
  "title": "Landom people site data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "copy",
    "institutions",
    "programs",
    "educationRecords",
    "people",
    "engagements",
    "works",
    "contributions",
    "achievements",
    "socialProfiles",
    "assets",
    "certificates"
  ],
  "properties": {
    "meta": { "$ref": "#/$defs/meta" },
    "copy": { "type": "object" },
    "institutions": { "type": "array", "items": { "$ref": "#/$defs/institution" } },
    "programs": { "type": "array", "items": { "$ref": "#/$defs/program" } },
    "educationRecords": { "type": "array", "items": { "$ref": "#/$defs/educationRecord" } },
    "people": { "type": "array", "items": { "$ref": "#/$defs/person" } },
    "engagements": { "type": "array", "items": { "$ref": "#/$defs/engagement" } },
    "works": { "type": "array", "items": { "$ref": "#/$defs/work" } },
    "contributions": { "type": "array", "items": { "$ref": "#/$defs/contribution" } },
    "achievements": { "type": "array", "items": { "$ref": "#/$defs/achievement" } },
    "socialProfiles": { "type": "array", "items": { "$ref": "#/$defs/socialProfile" } },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } },
    "certificates": {
      "type": "array",
      "minItems": 26,
      "maxItems": 26,
      "items": { "$ref": "#/$defs/certificate" },
      "allOf": [
        {
          "contains": { "type": "object", "required": ["programCode"], "properties": { "programCode": { "const": "FDI" } } },
          "minContains": 12,
          "maxContains": 12
        },
        {
          "contains": { "type": "object", "required": ["programCode"], "properties": { "programCode": { "const": "MSI" } } },
          "minContains": 5,
          "maxContains": 5
        },
        {
          "contains": { "type": "object", "required": ["programCode"], "properties": { "programCode": { "const": "IMP" } } },
          "minContains": 8,
          "maxContains": 8
        },
        {
          "contains": { "type": "object", "required": ["programCode"], "properties": { "programCode": { "const": "PDI" } } },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    }
  },
  "$defs": {
    "nullableString": { "type": ["string", "null"] },
    "nullableUri": { "type": ["string", "null"], "format": "uri" },
    "personId": { "type": "string", "pattern": "^[SPI]\\d{4}$" },
    "localized": {
      "type": "object",
      "additionalProperties": false,
      "required": ["th", "en"],
      "properties": {
        "th": { "$ref": "#/$defs/nullableString" },
        "en": { "$ref": "#/$defs/nullableString" }
      }
    },
    "localizedRequired": {
      "type": "object",
      "additionalProperties": false,
      "required": ["th", "en"],
      "properties": {
        "th": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    },
    "formalShort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formal", "short"],
      "properties": {
        "formal": { "type": "string", "minLength": 1 },
        "short": { "type": "string", "minLength": 1 }
      }
    },
    "formalShortLocalized": {
      "type": "object",
      "additionalProperties": false,
      "required": ["th", "en"],
      "properties": {
        "th": { "$ref": "#/$defs/formalShort" },
        "en": { "$ref": "#/$defs/formalShort" }
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "label"],
      "properties": {
        "start": { "$ref": "#/$defs/nullableString" },
        "end": { "$ref": "#/$defs/nullableString" },
        "label": { "$ref": "#/$defs/nullableString" }
      }
    },
    "meta": {
      "type": "object",
      "required": ["schemaVersion", "source", "personIdPolicy", "evidenceBoundary", "counts"],
      "properties": {
        "schemaVersion": { "const": "1.5.0" },
        "source": {
          "type": "object",
          "required": ["spreadsheetId", "publicSheetsUsed", "privateContactSourcesExcluded"],
          "properties": {
            "spreadsheetId": { "type": "string" },
            "publicSheetsUsed": { "type": "array", "items": { "type": "string" } },
            "privateContactSourcesExcluded": { "const": true }
          }
        },
        "personIdPolicy": {
          "type": "object",
          "required": ["version", "migrationDate", "frozenAfterMigration", "futureRoleChangesNeverChangePersonId"],
          "properties": {
            "version": { "const": "1.0" },
            "migrationDate": { "type": "string" },
            "frozenAfterMigration": { "const": true },
            "futureRoleChangesNeverChangePersonId": { "const": true }
          }
        },
        "evidenceBoundary": { "type": "object" },
        "counts": { "type": "object" }
      }
    },
    "institution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["institutionId", "names", "aliases", "verificationStatus", "linkedinUrl", "linkedinVerificationStatus"],
      "properties": {
        "institutionId": { "type": "string", "pattern": "^inst-[a-z0-9-]+$" },
        "names": { "$ref": "#/$defs/formalShortLocalized" },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "verificationStatus": { "type": "string" },
        "linkedinUrl": { "$ref": "#/$defs/nullableUri" },
        "linkedinVerificationStatus": { "enum": ["verified_official_page", "not_found_exact_official_page"] }
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": ["programId", "names", "qualificationLevel", "verificationStatus", "linkedinUrl", "linkedinVerificationStatus"],
      "properties": {
        "programId": { "type": "string", "pattern": "^program-[a-z0-9-]+$" },
        "names": { "$ref": "#/$defs/formalShortLocalized" },
        "qualificationLevel": { "$ref": "#/$defs/nullableString" },
        "verificationStatus": { "type": "string" },
        "linkedinUrl": { "$ref": "#/$defs/nullableUri" },
        "linkedinVerificationStatus": { "enum": ["verified_official_page", "not_found_exact_official_page"] }
      }
    },
    "educationRecord": {
      "type": "object",
      "required": ["educationRecordId", "personId", "institutionId", "programId", "isPrimary", "qualification", "degree", "verificationStatus"],
      "properties": {
        "educationRecordId": { "type": "string", "pattern": "^EDU\\d{4}$" },
        "personId": { "$ref": "#/$defs/personId" },
        "institutionId": { "type": "string" },
        "programId": { "type": ["string", "null"] },
        "isPrimary": { "type": "boolean" },
        "qualification": { "$ref": "#/$defs/localized" },
        "degree": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["abbreviation", "title", "field", "awardStatus", "personalAwardVerified", "programEvidenceUrl", "evidenceScope"],
              "properties": {
                "abbreviation": { "$ref": "#/$defs/localized" },
                "title": { "$ref": "#/$defs/localized" },
                "field": { "$ref": "#/$defs/localized" },
                "awardStatus": { "enum": ["under_review", "in_progress", "completed"] },
                "personalAwardVerified": { "type": "boolean" },
                "programEvidenceUrl": { "$ref": "#/$defs/nullableUri" },
                "evidenceScope": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        "verificationStatus": { "type": "string" }
      }
    },
    "person": {
      "type": "object",
      "required": ["personId", "names", "migrationClassification", "canonicalIdPolicy", "educationDisplayMode", "educationDisplay", "bio", "publication"],
      "properties": {
        "personId": { "$ref": "#/$defs/personId" },
        "names": {
          "type": "object",
          "required": ["full", "nickname", "card"],
          "properties": {
            "full": { "$ref": "#/$defs/localized" },
            "nickname": { "$ref": "#/$defs/localized" },
            "card": { "$ref": "#/$defs/localized" }
          }
        },
        "migrationClassification": { "enum": ["full_time", "part_time", "intern_or_program_participant"] },
        "canonicalIdPolicy": {
          "type": "object",
          "required": ["assignedAtMigration", "categoryAtMigration", "frozenAcrossFutureRoleChanges"],
          "properties": { "frozenAcrossFutureRoleChanges": { "const": true } }
        },
        "educationDisplayMode": { "enum": ["qualification", "program", "neutral"] },
        "educationDisplay": {
          "type": "object",
          "required": ["mode", "card", "detail", "verificationStatus"],
          "properties": {
            "mode": { "enum": ["qualification", "program", "neutral"] },
            "card": { "$ref": "#/$defs/localized" },
            "detail": { "$ref": "#/$defs/localized" },
            "verificationStatus": { "type": "string" }
          }
        },
        "bio": {
          "type": "object",
          "additionalProperties": false,
          "required": ["th", "en", "status", "verificationStatus", "publicationBasis", "sourceBasis", "sourceType", "sourceRef", "authorRole", "derivationMethod", "evidenceScope", "evidenceConfidence", "reviewStatus", "ownerApproval"],
          "properties": {
            "th": { "$ref": "#/$defs/nullableString" },
            "en": { "$ref": "#/$defs/nullableString" },
            "status": { "enum": ["owner_pending", "source_backed_placeholder", "owner_approved"] },
            "verificationStatus": { "enum": ["owner_pending", "owner_authorized_placeholder", "owner_approved"] },
            "publicationBasis": { "enum": [null, "owner_authorized_paraphrase_from_first_person_application", "owner_authorized_synthesis_from_roster_evidence"] },
            "sourceBasis": { "enum": [null, "first_person_application_exact_roster_match", "factual_role_education_and_work_evidence"] },
            "sourceType": { "enum": [null, "first_person_application", "factual_fallback", "candidate_video_transcript", "owner_supplied_copy"] },
            "sourceRef": { "$ref": "#/$defs/nullableString" },
            "authorRole": { "enum": [null, "profile_subject", "assistant_paraphrase_from_owner_and_sheet_records", "directory_owner"] },
            "derivationMethod": { "enum": [null, "concise_paraphrase", "bounded_inference", "video_transcript_synthesis", "verbatim_owner_copy"] },
            "evidenceScope": { "$ref": "#/$defs/nullableString" },
            "evidenceConfidence": { "enum": [null, "exact_roster_match", "owner_confirmed", "high", "medium_high", "medium", "medium_low"] },
            "reviewStatus": { "enum": ["pending_owner_copy", "pending_candidate_video_review", "owner_approved"] },
            "ownerApproval": { "$ref": "#/$defs/ownerApprovalNullable" }
          }
        },
        "publication": {
          "type": "object",
          "required": ["consentStatus", "profileStatus"],
          "properties": {
            "consentStatus": { "enum": ["pending", "granted", "denied"] },
            "profileStatus": { "enum": ["eligible", "withheld_pending_consent"] }
          }
        }
      }
    },
    "engagement": {
      "type": "object",
      "required": ["engagementId", "personId", "category", "academicPlacementType", "program", "roleTitle", "status", "responsibilityWorkIds"],
      "properties": {
        "engagementId": { "type": "string", "pattern": "^E\\d{4}$" },
        "personId": { "$ref": "#/$defs/personId" },
        "category": { "enum": ["full_time", "part_time", "internship", "program_participant"] },
        "academicPlacementType": { "enum": ["cooperative_education", "internship", "not_applicable"] },
        "program": {
          "type": "object",
          "required": ["code", "names"],
          "properties": {
            "code": { "type": "string" },
            "names": { "$ref": "#/$defs/localizedRequired" }
          }
        },
        "roleTitle": { "$ref": "#/$defs/localized" },
        "status": { "enum": ["ongoing", "completed"] },
        "responsibilityWorkIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "work": {
      "type": "object",
      "required": ["workId", "parentProduct", "moduleSlug", "names", "shortNames", "type", "scopeLayer", "authorityStatus", "catalogUrl", "destinationUrl", "linkEvidence"],
      "properties": {
        "workId": { "type": "string", "pattern": "^work-[a-z0-9-]+$" },
        "parentProduct": { "type": "string" },
        "moduleSlug": { "type": ["string", "null"] },
        "names": { "$ref": "#/$defs/localizedRequired" },
        "shortNames": { "$ref": "#/$defs/localizedRequired" },
        "type": { "type": "string" },
        "scopeLayer": { "enum": ["shared_landometer", "product_specific", "partner_specific"] },
        "authorityStatus": { "type": "string" },
        "catalogUrl": { "$ref": "#/$defs/localized" },
        "destinationUrl": { "$ref": "#/$defs/nullableUri" },
        "linkEvidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["linkScope", "sourceRef", "evidenceUrl"],
          "properties": {
            "linkScope": { "enum": ["exact_module", "exact_product", "evidence_only", "broader_catalog", "unverified_no_link"] },
            "sourceRef": { "$ref": "#/$defs/nullableString" },
            "evidenceUrl": { "$ref": "#/$defs/nullableUri" }
          }
        }
      }
    },
    "contribution": {
      "type": "object",
      "required": ["contributionId", "personId", "workId", "engagementId", "role", "period", "evidenceStatus", "sourceRef"],
      "properties": {
        "contributionId": { "type": "string", "pattern": "^C\\d{4}$" },
        "personId": { "$ref": "#/$defs/personId" },
        "workId": { "type": "string" },
        "engagementId": { "type": ["string", "null"] },
        "role": { "$ref": "#/$defs/localizedRequired" },
        "period": { "$ref": "#/$defs/period" },
        "evidenceStatus": { "enum": ["sheet_recorded", "owner_supplied", "owner_and_sheet_confirmed", "owner_detail_required"] },
        "sourceRef": { "type": "string" }
      }
    },
    "achievement": {
      "type": "object",
      "required": ["achievementId", "title", "recipientPersonIds", "workId", "evidenceStatus"],
      "properties": {
        "achievementId": { "type": "string", "pattern": "^A\\d{4}$" },
        "title": { "$ref": "#/$defs/localizedRequired" },
        "recipientPersonIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/personId" } },
        "workId": { "type": ["string", "null"] },
        "evidenceStatus": { "type": "string" }
      }
    },
    "socialProfile": {
      "type": "object",
      "required": ["socialProfileId", "personId", "platform", "publicUrl", "candidateStatus", "verificationStatus", "consentStatus", "publicationBasis", "ownerApproval", "publicationStatus", "dataBoundary"],
      "properties": {
        "socialProfileId": { "type": "string", "pattern": "^SOC-[SPI]\\d{4}-[A-Z]+$" },
        "personId": { "$ref": "#/$defs/personId" },
        "platform": { "enum": ["linkedin", "github", "gitlab", "website", "facebook", "instagram", "tiktok"] },
        "publicUrl": { "type": ["string", "null"], "format": "uri" },
        "candidateStatus": { "enum": ["candidate_present", "candidate_missing"] },
        "verificationStatus": { "enum": ["owner_review_required", "verified", "rejected", "missing"] },
        "consentStatus": { "enum": ["pending", "granted", "denied"] },
        "publicationBasis": { "enum": [null, "individual_consent", "owner_authorized_public_profile_link"] },
        "ownerApproval": { "$ref": "#/$defs/ownerApprovalNullable" },
        "publicationStatus": { "enum": ["publishable", "withheld_pending_candidate", "withheld_pending_consent", "withheld_pending_verification", "withdrawn"] },
        "dataBoundary": { "const": "private_candidates_not_emitted" }
      }
    },
    "asset": {
      "type": "object",
      "required": ["assetId", "personId", "kind", "publicPath", "sourceUrl", "alt", "candidateStatus", "verificationStatus", "consentStatus", "rightsStatus", "publicationBasis", "ownerApproval", "publicationStatus", "sha256", "mediaType", "bytes", "identityVerificationEvidence"],
      "properties": {
        "assetId": { "type": "string", "pattern": "^PORTRAIT-[SPI]\\d{4}$" },
        "personId": { "$ref": "#/$defs/personId" },
        "kind": { "const": "profile_portrait" },
        "publicPath": { "type": ["string", "null"] },
        "sourceUrl": { "$ref": "#/$defs/nullableUri" },
        "alt": { "$ref": "#/$defs/localizedRequired" },
        "candidateStatus": { "enum": ["candidate_present", "source_needed"] },
        "verificationStatus": { "enum": ["owner_review_required", "verified", "rejected", "missing"] },
        "consentStatus": { "enum": ["pending", "granted", "denied"] },
        "rightsStatus": { "enum": ["pending", "cleared", "denied", "revoked"] },
        "publicationBasis": { "enum": [null, "individual_consent", "owner_authorized_public_profile_portrait"] },
        "ownerApproval": { "$ref": "#/$defs/ownerApprovalNullable" },
        "publicationStatus": { "enum": ["publishable", "withheld_pending_rights_consent_and_verification", "withdrawn"] },
        "sha256": { "$ref": "#/$defs/nullableString" },
        "mediaType": { "$ref": "#/$defs/nullableString" },
        "bytes": { "type": ["integer", "null"], "minimum": 0 },
        "identityVerificationEvidence": { "$ref": "#/$defs/nullableString" }
      }
    },
    "certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "certificateId",
        "personId",
        "credentialId",
        "programCode",
        "title",
        "roleLabel",
        "awardedOn",
        "printedWorkTitle",
        "workIds",
        "publicPath",
        "downloadFilename",
        "sha256",
        "bytes",
        "mimeType",
        "verificationStatus",
        "publicationStatus",
        "rightsStatus",
        "consentStatus",
        "publicationBasis",
        "ownerApproval",
        "nameSpellingStatus",
        "credentialIdCollisionStatus",
        "dateEvidenceStatus",
        "evidenceNotes",
        "evidenceBoundary"
      ],
      "properties": {
        "certificateId": { "type": "string", "pattern": "^CERT-[SPI]\\d{4}-[A-Z0-9]+$" },
        "personId": { "$ref": "#/$defs/personId" },
        "credentialId": { "type": "string", "pattern": "^[A-Z]{3}\\d{5}$" },
        "programCode": { "enum": ["FDI", "PDI", "MSI", "IMP"] },
        "title": { "$ref": "#/$defs/localizedRequired" },
        "roleLabel": { "$ref": "#/$defs/localizedRequired" },
        "awardedOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "printedWorkTitle": { "type": "string", "minLength": 1 },
        "workIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "publicPath": { "type": "string", "pattern": "^public/assets/certificates/[SPI]\\d{4}-[A-Z0-9]+\\.png$" },
        "downloadFilename": { "type": "string", "pattern": "^landometer-certificate-[SPI]\\d{4}-[A-Z0-9]+\\.png$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 1 },
        "mimeType": { "const": "image/png" },
        "verificationStatus": { "const": "verified" },
        "publicationStatus": { "const": "publishable" },
        "rightsStatus": { "const": "cleared" },
        "consentStatus": { "const": "pending" },
        "publicationBasis": { "const": "owner_authorized_public_certificate" },
        "ownerApproval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "approvedAt", "scope", "sourceRef"],
          "properties": {
            "status": { "const": "granted" },
            "approvedAt": { "type": "string", "minLength": 1 },
            "scope": { "const": "public_certificate_image_and_printed_profile_facts" },
            "sourceRef": { "type": "string", "minLength": 1 }
          }
        },
        "nameSpellingStatus": { "enum": ["matched", "owner_review_required"] },
        "credentialIdCollisionStatus": { "enum": ["unique_in_printed_source", "duplicate_in_printed_source"] },
        "dateEvidenceStatus": { "enum": ["printed_date_only", "printed_date_conflicts_with_program_code"] },
        "evidenceNotes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "evidenceBoundary": { "const": "printed_certificate_facts_only_qr_destinations_excluded" }
      }
    },
    "ownerApprovalNullable": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "approvedAt", "scope", "sourceRef"],
          "properties": {
            "status": { "const": "granted" },
            "approvedAt": { "$ref": "#/$defs/nullableString" },
            "scope": { "$ref": "#/$defs/nullableString" },
            "sourceRef": { "$ref": "#/$defs/nullableString" }
          }
        }
      ]
    }
  }
}
